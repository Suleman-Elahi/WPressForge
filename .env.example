# ---------------------------------------------------------------- panel
WP_PANEL_BIND=127.0.0.1:8080
WP_PANEL_DB=data/panel.db
WP_PANEL_STATIC=static
WP_PANEL_WORKERS=4

# Created on first run. If the password is unset a random one is logged once.
WP_PANEL_ADMIN_EMAIL=admin@example.com
# WP_PANEL_ADMIN_PASSWORD=

# Set to true when the panel is served over HTTPS (it should be).
WP_PANEL_SECURE_COOKIES=false

# Example server + sites on first run, and simulated jobs when no agent
# answers. Turn off for production.
WP_PANEL_DEMO_DATA=true

WP_PANEL_LOG=info,sqlx=warn

# ---------------------------------------------------------------- agent
WP_AGENT_BIND=0.0.0.0:8443
WP_AGENT_TOKEN=change-me-at-least-24-characters
WP_AGENT_SITES_ROOT=/var/www
WP_AGENT_NGINX_DIR=/etc/nginx/sites-enabled
WP_AGENT_STATE=/var/lib/wp-agent/state.json
WP_AGENT_UID_BASE=10001

# Log commands instead of running them. Start here on a new host.
WP_AGENT_DRY_RUN=true

# WP_AGENT_RESTIC_REPO=s3:s3.amazonaws.com/my-wp-backups
# WP_AGENT_ACME_EMAIL=ops@example.com
WP_AGENT_LOG=info
