# ---------------------------------------------------------------- panel
WP_PANEL_BIND=127.0.0.1:8080
WP_PANEL_DB=data/panel.db
WP_PANEL_STATIC=static
WP_PANEL_WORKERS=4

# Created on first run. If the password is unset a random one is logged once.
WP_PANEL_ADMIN_EMAIL=admin@example.com
# WP_PANEL_ADMIN_PASSWORD=

# Set to true when the panel is served over HTTPS (it should be).
WP_PANEL_SECURE_COOKIES=false

# Example server + sites on first run, and simulated jobs when no agent
# answers. Turn off for production.
WP_PANEL_DEMO_DATA=true

# AES-256-GCM key (base64, 32 bytes) sealing backup destination credentials.
# Generated into <db_dir>/secret.key on first run if unset. Set it explicitly in
# production and back it up: without it, stored destination secrets are unusable.
# WP_PANEL_SECRET_KEY=

# Outgoing mail for invitations. With no host, invitation emails are written to
# the log instead of being sent.
# WP_PANEL_SMTP_HOST=smtp.example.com
WP_PANEL_SMTP_PORT=587
# WP_PANEL_SMTP_USER=panel@example.com
# WP_PANEL_SMTP_PASSWORD=
WP_PANEL_SMTP_FROM=wp-panel@example.com

WP_PANEL_LOG=info,sqlx=warn

# ---------------------------------------------------------------- agent
WP_AGENT_BIND=0.0.0.0:8443
WP_AGENT_TOKEN=change-me-at-least-24-characters
WP_AGENT_SITES_ROOT=/var/www
WP_AGENT_NGINX_DIR=/etc/nginx/sites-enabled
WP_AGENT_CACHE_ROOT=/var/cache/nginx
WP_AGENT_STATE=/var/lib/wp-agent/state.json
WP_AGENT_UID_BASE=10001

# TLS for the operations API. With no cert/key the agent generates a self-signed
# pair next to its state file and logs the fingerprint to pin in the panel.
WP_AGENT_TLS_SELF_SIGNED=true
# WP_AGENT_TLS_CERT=/var/lib/wp-agent/agent.crt
# WP_AGENT_TLS_KEY=/var/lib/wp-agent/agent.key

# Log commands instead of running them. Start here on a new host.
WP_AGENT_DRY_RUN=true

# WP_AGENT_RESTIC_REPO=s3:s3.amazonaws.com/my-wp-backups
# WP_AGENT_ACME_EMAIL=ops@example.com
WP_AGENT_LOG=info
